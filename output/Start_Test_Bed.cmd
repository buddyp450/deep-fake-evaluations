@echo off
set "RD_TESTBED_DIR=%~dp0"
powershell.exe -NoProfile -Command "$folder=$env:RD_TESTBED_DIR; $bundled=Join-Path $env:USERPROFILE '.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe'; $projectPython=Join-Path $folder '..\.venv-video\Scripts\python.exe'; if(Test-Path -LiteralPath $bundled){$runtime=$bundled;$prefix=@()} elseif(Test-Path -LiteralPath $projectPython){$runtime=$projectPython;$prefix=@()} elseif(Get-Command py.exe -ErrorAction SilentlyContinue){$runtime=(Get-Command py.exe).Source;$prefix=@('-3')} elseif(Get-Command python.exe -ErrorAction SilentlyContinue){$runtime=(Get-Command python.exe).Source;$prefix=@()} else {Write-Host 'Python 3 is required to start this local test bed.';Read-Host 'Press Enter';exit 1}; $script=Join-Path $folder 'serve_test_bed.py'; $quote=[char]34; $arguments=$prefix+@(($quote+$script+$quote),'--open'); Start-Process -FilePath $runtime -ArgumentList $arguments -WorkingDirectory $folder -WindowStyle Hidden -RedirectStandardError (Join-Path $folder 'test_bed_server.log')"
